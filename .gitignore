# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flavor environment files — contain real API URLs, never commit
.env.dev.json
.env.staging.json
.env.prod.json

# Generated flavor icon yamls — recreated by sync_flavors.dart
flutter_launcher_icons-*.yaml

# Claude Code — personal settings stay local; skills ship with the template,
# because they name its files and must change in the same commit as them.
.claude/*
!.claude/skills/

# Figma pull — .figma/token is a real credential, .figma/cache is regenerable.
# The whole folder is ignored: a token committed once stays in history forever,
# even after it is deleted in a later commit.
.figma/

# template_update.dart — template copies of conflicting files, merged by hand then deleted
.template_update/

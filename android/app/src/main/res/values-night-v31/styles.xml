<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      أندرويد 12+ — `SplashScreen API`، والنظامُ يملك الشاشة لا نحن.

      **الرمزُ وحده بلا نصّ.** النظام يقصّ `windowSplashScreenAnimatedIcon`
      بقناعٍ دائري ويكبّره، فشعارٌ بنصٍّ يخرج مبتوراً. و`splash_icon_v31` الرمزُ
      وحده داخل لوحةٍ مربّعة تُبقي كلَّ حبرٍ داخل الدائرة.

      **و`windowBackground` ليس زينة.** بلاه يرث الثيمُ خلفيته الافتراضية، فيقع
      إطارٌ بلونٍ آخر بين splash النظام وأوّل إطارٍ من فلاتر.

      ⚠️ **وحركةُ الخروج (تكبيرُ الرمز وتلاشيه) من النظام ولا تُطفأ من XML** —
      `windowSplashScreenAnimationDuration` يمسّ الدخول وحده. ما يجعلها غير
      محسوسة أن ما قبلها وما بعدها متطابقان: نفس اللون، ونفس الرمز، بنفس المركز.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- شريطا النظام شفّافان من أول لحظة — التطبيق `edgeToEdge`، و
             `windowFullscreen` هنا يُخفي شريط الحالة ثم يعيده فلاتر فيقفز التخطيط. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_v31</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <!-- ثيمُ النافذة بعد إقلاع العملية وحتى يرسم فلاتر أول إطار — بلون splash
         لا بـ`?android:colorBackground`، وإلا ومض أبيضَ بالوضع الفاتح. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ما دون أندرويد 12 — النافذةُ ملكنا كاملةً، والرسمةُ `launch_background`.

      **ولا `windowFullscreen` بعد اليوم:** كان يُخفي شريط الحالة أثناء
      الإقلاع، ثم يُشغّل التطبيق `SystemUiMode.edgeToEdge` فيعود الشريط —
      فيقفز التخطيط لحظة التسليم. والشفافيةُ من أول لحظة تُلغي القفزة.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!--
      ثيمُ النافذة بعد إقلاع العملية وحتى يرسم فلاتر أول إطار (يستبدله
      الـembedding V2 بنفسه). وكان `?android:colorBackground` — أي **أبيضَ**
      بالوضع الفاتح، فيقع إطارٌ أبيضُ بين شاشة الإقلاع وأول إطار.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
